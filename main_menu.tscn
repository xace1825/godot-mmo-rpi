[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.08, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -180.0
offset_right = 150.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Fantasy Settlement MMO"
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 28

[node name="SingleplayerButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Singleplayer"

[node name="HostButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Host Server"

[node name="JoinIPInput" type="LineEdit" parent="VBoxContainer"]
layout_mode = 2
placeholder_text = "Server IP (e.g. 192.168.0.102)"
alignment = 1

[node name="JoinPortInput" type="LineEdit" parent="VBoxContainer"]
layout_mode = 2
placeholder_text = "Port (default 7777)"
alignment = 1

[node name="JoinButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Join Server"

[node name="ExitButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Exit"

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = ""
horizontal_alignment = 1
vertical_alignment = 1
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)

[connection signal="pressed" from="VBoxContainer/SingleplayerButton" to="." method="_on_singleplayer"]
[connection signal="pressed" from="VBoxContainer/HostButton" to="." method="_on_host"]
[connection signal="pressed" from="VBoxContainer/JoinButton" to="." method="_on_join"]
[connection signal="pressed" from="VBoxContainer/ExitButton" to="." method="_on_exit"]
